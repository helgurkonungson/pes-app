// Chompbook AI server (Pro) — api.chompbook.online. ADR-037, setup: docs/PRO_SETUP.md.
// Deploy: Cloudflare dashboard → Workers & Pages → Create → Import a repository → root directory "api",
// production branch "pro" until 1.0.0 is merged into main (main has no api/ before that).
// Secrets (dashboard → the Worker → Settings → Variables and secrets): OPENROUTER_KEY, REVENUECAT_SECRET.
{
  "name": "chompbook-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "api.chompbook.online", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chompbook-api",
      "database_id": "666cf7f2-6837-4fb3-83e4-29e8b24b7928"
    }
  ],
  "vars": {
    // OpenRouter model for Pro lessons; change here (or in the dashboard) without an app update
    "MODEL": "anthropic/claude-haiku-5.5",
    "FALLBACK_MODELS": "deepseek/deepseek-v4.1-flash-1017",
    // per learner per UTC day (prompt + answer tokens); ~60 000 per 15-minute AI lesson
    "DAILY_TOKENS": "600000",
    // during the 7-day free trial (≈ 3 lessons a day) and for all users together per UTC day (a spending stop)
    "TRIAL_DAILY_TOKENS": "180000",
    "GLOBAL_DAILY_TOKENS": "6000000",
    "ENTITLEMENT": "pro"
  },
  // daily clean-up: usage older than 90 days, cached subscription answers unused for 30 days
  "triggers": { "crons": ["17 3 * * *"] },
  // errors and our own console messages only: no per-request logs (they would hold IP addresses)
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
